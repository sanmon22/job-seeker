# ==========================================
# Entorno General
# ==========================================
NODE_ENV=development
APP_NAME=job-seeker-auto

# ==========================================
# Configuración del Servicio Playwright
# ==========================================
PLAYWRIGHT_PORT=3000
STORAGE_STATE_PATH=./data/sessions/storageState.json
HEADLESS_MODE=true

# ==========================================
# CompuTrabajo Defaults
# ==========================================
COMPUTRABAJO_BASE_URL=https://co.computrabajo.com
DEFAULT_SEARCH_KEYWORDS=QA Analyst
DEFAULT_SEARCH_LOCATION=Bogota
MAX_SEARCH_PAGES=2

# ==========================================
# Configuración de Ollama (IA Local)
# ==========================================
# Dentro de docker se usa http://ollama:11434, localmente http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=
MATCH_THRESHOLD_PERCENT=

# ==========================================
# Configuración de n8n
# ==========================================
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
WEBHOOK_URL=http://localhost:5678/

# ==========================================
# Base de Datos SQLite
# ==========================================
SQLITE_DB_PATH=./data/jobs.sqlite

# ==========================================
# Notificaciones (Opcional - Telegram / Webhook)
# ==========================================
NOTIFICATION_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=